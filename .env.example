# Server-only Supabase PostgreSQL connection. Use a rotated credential and
# the transaction-pooler URL from Supabase/Vercel; never expose this as NEXT_PUBLIC.
POSTGRES_PRISMA_URL=postgres://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require&pgbouncer=true
# Optional Supabase database CA certificate (PEM), with newlines preserved or escaped as \n.
# When unset, the app uses the bundled supabase/prod-ca-2021.crt certificate.
POSTGRES_CA_CERT=

# Canonical production origin for metadata, hreflang, JSON-LD and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://annabid.com

# Required security configuration. Generate AUTH_SECRET with crypto.randomBytes(32).toString('hex').
# Keep it stable in your secret manager: it encrypts administrator MFA secrets.
AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Administrator provisioning identity. Supply ADMIN_PASSWORD only through your secret manager.
ADMIN_EMAIL=admin@annabid.com
ADMIN_PASSWORD=ALLO123@
# Explicit HTTPS origins, comma-separated; never use a wildcard. VERCEL_URL is also trusted.
TRUSTED_ORIGINS=
# Only set behind a proxy that strips and overwrites this header. Vercel uses its own trusted header.
TRUSTED_PROXY_IP_HEADER=
# A monitored HTTPS vulnerability-reporting URL or mailto address for security.txt.
SECURITY_CONTACT=
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_TOKEN=
# Optional Supabase Storage for public, sanitized images. Server-only service key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_BUCKET=public-images
