# Server-only Supabase PostgreSQL connection. Use a rotated credential and
# the transaction-pooler URL from Supabase/Vercel; never expose this as NEXT_PUBLIC.
POSTGRES_PRISMA_URL=postgres://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?sslmode=require&pgbouncer=true
# Optional Supabase database CA certificate (PEM), with newlines preserved or escaped as \n.
POSTGRES_CA_CERT=
